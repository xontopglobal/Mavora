{
  "name": "ofsocio-platform",
  "version": "0.4.3",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @ofsocio/web",
    "dev:web": "npm run dev --workspace @ofsocio/web",
    "dev:api": "npm run dev --prefix apps/api",
    "build": "npm run build --workspace @ofsocio/web",
    "preview": "npm run preview --workspace @ofsocio/web",
    "start:api": "npm run start --prefix apps/api",
    "install:api": "npm install --prefix apps/api"
  },
  "engines": {
    "node": ">=18"
  }
}
